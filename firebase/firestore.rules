rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function validNewUser(uid) {
      return request.resource.data.keys().hasAll([
          'uid', 'username', 'usernameLower', 'email', 'avatarUrl',
          'skinUrl', 'capeUrl', 'skinModel', 'role', 'createdAt', 'stats'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameLower', 'email', 'avatarUrl',
          'skinUrl', 'capeUrl', 'skinModel', 'role', 'createdAt', 'stats'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 16
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.email == request.resource.data.usernameLower + '@aurora.internal'
        && request.resource.data.avatarUrl == null
        && request.resource.data.skinUrl == null
        && request.resource.data.capeUrl == null
        && request.resource.data.skinModel == 'classic'
        && request.resource.data.role == 'PLAYER'
        && request.resource.data.createdAt == request.time
        && request.resource.data.stats is map
        && request.resource.data.stats.keys().hasAll([
          'totalPlayTimeSeconds', 'questsCompleted', 'lastPlayedModpack'
        ])
        && request.resource.data.stats.keys().hasOnly([
          'totalPlayTimeSeconds', 'questsCompleted', 'lastPlayedModpack'
        ])
        && request.resource.data.stats.totalPlayTimeSeconds == 0
        && request.resource.data.stats.questsCompleted == 0
        && request.resource.data.stats.lastPlayedModpack == null;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validNewUser(uid);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['avatarUrl', 'skinUrl', 'capeUrl', 'skinModel', 'skinFavorites', 'updatedAt']);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 16
        && request.resource.data.username.matches('^[A-Za-z0-9_]+$')
        && (request.resource.data.avatarUrl == null
          || (request.resource.data.avatarUrl is string
            && request.resource.data.avatarUrl.matches('^https://.+')))
        && (request.resource.data.skinUrl == null
          || (request.resource.data.skinUrl is string
            && request.resource.data.skinUrl.matches('^https://.+')))
        && request.resource.data.skinModel in ['classic', 'slim']
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'avatarUrl', 'skinUrl', 'skinModel', 'updatedAt'
        ]);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && (request.resource.data.avatarUrl == null
          || (request.resource.data.avatarUrl is string
            && request.resource.data.avatarUrl.matches('^https://.+')))
        && (request.resource.data.skinUrl == null
          || (request.resource.data.skinUrl is string
            && request.resource.data.skinUrl.matches('^https://.+')))
        && request.resource.data.skinModel in ['classic', 'slim']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['avatarUrl', 'skinUrl', 'skinModel', 'updatedAt']);
      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'usernameLower', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'usernameLower', 'createdAt'])
        && request.resource.data.usernameLower == usernameLower
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == usernameLower;
      allow update, delete: if false;
    }

    // Social state is private. Reciprocal writes use transforms, never peer graph reads.
    function socialUid(uid) { return uid is string && uid.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function socialAccount(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return profile.uid == uid && profile.usernameLower.matches('^[a-z0-9_]{3,16}$')
        && get(/databases/$(database)/documents/usernames/$(profile.usernameLower)).data.uid == uid;
    }
    function socialState(uid) {
      return get(/databases/$(database)/documents/socialState/$(uid)).data;
    }
    function socialAfter(uid) { return getAfter(/databases/$(database)/documents/socialState/$(uid)).data; }
    function socialHas(uid, field, peer) { return exists(/databases/$(database)/documents/socialState/$(uid)) && peer in socialState(uid)[field]; }
    function socialBlocked(a, b) { return socialHas(a, 'blocked', b) || socialHas(b, 'blocked', a); }
    function socialFriends(a, b) { return socialHas(a, 'friends', b) && socialHas(b, 'friends', a) && !socialBlocked(a, b); }
    function socialLists(d, f, i, o, b) {
      return d.friends == f && d.incoming == i && d.outgoing == o && d.blocked == b;
    }
    function socialShape(d) {
      return d.keys().hasAll(['friends','incoming','outgoing','blocked','revision','kind','actor','peer','updatedAt'])
        && d.keys().hasOnly(['friends','incoming','outgoing','blocked','revision','kind','actor','peer','updatedAt'])
        && d.friends is list && d.friends.size() <= 100 && d.friends.toSet().size() == d.friends.size()
        && d.incoming is list && d.incoming.size() <= 10 && d.incoming.toSet().size() == d.incoming.size()
        && d.outgoing is list && d.outgoing.size() <= 10 && d.outgoing.toSet().size() == d.outgoing.size()
        && d.blocked is list && d.blocked.size() <= 100 && d.blocked.toSet().size() == d.blocked.size()
        && d.revision is int && d.updatedAt == request.time
        && socialUid(d.actor) && socialUid(d.peer);
    }
    function socialTransition(uid, d, old) {
      let p = d.peer;
      let own = uid == request.auth.uid;
      return (d.kind == 'request' && !socialBlocked(uid, p) && !(p in old.friends) && !(p in old.incoming) && !(p in old.outgoing)
          && ((own && socialLists(d, old.friends, old.incoming, old.outgoing.concat([p]), old.blocked))
            || (!own && socialLists(d, old.friends, old.incoming.concat([p]), old.outgoing, old.blocked))))
        || (d.kind == 'accept' && !socialBlocked(uid, p) && !(p in old.friends)
          && ((own && p in old.incoming && get(/databases/$(database)/documents/socialRequests/$(p)/peers/$(uid)).data.expiresAt > request.time)
            || (!own && p in old.outgoing && get(/databases/$(database)/documents/socialRequests/$(uid)/peers/$(p)).data.expiresAt > request.time))
          && socialLists(d, old.friends.concat([p]), old.incoming.removeAll([p]), old.outgoing.removeAll([p]), old.blocked))
        || (d.kind == 'decline' && ((own && p in old.incoming) || (!own && p in old.outgoing))
          && socialLists(d, old.friends, old.incoming.removeAll([p]), old.outgoing.removeAll([p]), old.blocked))
        || (d.kind == 'cancel' && ((own && p in old.outgoing) || (!own && p in old.incoming))
          && socialLists(d, old.friends, old.incoming.removeAll([p]), old.outgoing.removeAll([p]), old.blocked))
        || (d.kind == 'remove' && p in old.friends && socialLists(d, old.friends.removeAll([p]), old.incoming, old.outgoing, old.blocked))
        || (d.kind == 'block' && ((!own && socialLists(d, old.friends.removeAll([p]), old.incoming.removeAll([p]), old.outgoing.removeAll([p]), old.blocked))
          || (own && !(p in old.blocked) && socialLists(d, old.friends.removeAll([p]), old.incoming.removeAll([p]), old.outgoing.removeAll([p]), old.blocked.concat([p])))));
    }
    function socialBlank() { return {'friends': [], 'incoming': [], 'outgoing': [], 'blocked': [], 'revision': 0}; }
    function socialPair(uid, d, old, otherOld) {
      let other = socialAfter(d.peer);
      return uid != d.peer && (request.auth.uid == uid || request.auth.uid == d.peer)
        && d.actor == request.auth.uid && other.actor == d.actor && other.kind == d.kind && other.peer == uid
        && other.revision == otherOld.revision + 1 && other.updatedAt == request.time
        && (d.kind != 'request' && d.kind != 'block' || (socialAccount(uid) && socialAccount(d.peer)))
        && socialTransition(uid, d, old)
        && (d.kind != 'request' || (getAfter(/databases/$(database)/documents/socialThrottle/$(request.auth.uid)).data.at == request.time
          && ((uid == request.auth.uid && getAfter(/databases/$(database)/documents/socialRequests/$(uid)/peers/$(d.peer)).data.createdAt == request.time)
            || (uid != request.auth.uid && getAfter(/databases/$(database)/documents/socialRequests/$(d.peer)/peers/$(uid)).data.createdAt == request.time))))
        && (d.kind == 'request' || (!existsAfter(/databases/$(database)/documents/socialRequests/$(uid)/peers/$(d.peer))
          && !existsAfter(/databases/$(database)/documents/socialRequests/$(d.peer)/peers/$(uid))));
    }
    function socialPaired(uid, d, old) {
      return (exists(/databases/$(database)/documents/socialState/$(d.peer)) && socialPair(uid, d, old, socialState(d.peer)))
        || (!exists(/databases/$(database)/documents/socialState/$(d.peer)) && socialPair(uid, d, old, socialBlank()));
    }
    match /socialState/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create: if signedIn() && socialUid(uid) && socialShape(request.resource.data)
        && request.resource.data.revision == 1 && socialPaired(uid, request.resource.data, socialBlank());
      allow update: if signedIn() && socialUid(uid) && socialShape(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && (socialPaired(uid, request.resource.data, resource.data)
          || (request.auth.uid == uid && request.resource.data.actor == uid && request.resource.data.kind == 'unblock'
            && request.resource.data.peer in resource.data.blocked
            && socialLists(request.resource.data, resource.data.friends, resource.data.incoming,
              resource.data.outgoing, resource.data.blocked.removeAll([request.resource.data.peer]))));
    }
    match /socialThrottle/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && (!exists(/databases/$(database)/documents/socialThrottle/$(uid)) || request.time >= resource.data.at + duration.value(2, 's'));
    }
    match /socialRequests/{sender}/peers/{receiver} {
      allow get: if signedIn() && request.auth.uid in [sender, receiver];
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == sender && sender != receiver
        && request.resource.data.keys().hasOnly(['createdAt','expiresAt'])
        && request.resource.data.createdAt == request.time && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(7,'d')
        && socialAfter(sender).kind == 'request' && socialAfter(sender).peer == receiver && socialAfter(sender).updatedAt == request.time
        && socialAfter(receiver).kind == 'request' && socialAfter(receiver).peer == sender && socialAfter(receiver).updatedAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in [sender, receiver]
        && socialAfter(sender).actor == request.auth.uid && socialAfter(sender).updatedAt == request.time
        && !(receiver in socialAfter(sender).outgoing) && !(sender in socialAfter(receiver).incoming);
    }
    function socialImage(value) {
      return value == null || (value is string && value.size() <= 512
        && value.matches('^https://(cdn[.]modrinth[.]com|media[.]forgecdn[.]net|mediafilez[.]forgecdn[.]net)/[A-Za-z0-9_./%+-]+[.](png|jpg|jpeg|webp)$'));
    }
    function socialSessionId(id) { return id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'); }
    function socialText(value, maximum) {
      return value is string && value.size() >= 1 && value.size() <= maximum
        && value.matches('^[^\\x00-\\x1f\\x7f]+$') && !value.matches('^ +$');
    }
    function socialSessionShape(d) {
      return d.keys().hasAll(['schema','hostUid','title','modpackName','minecraftVersion','loader','imageUrl','players','maxPlayers','visibility','joinPolicy','expiresAt'])
        && d.keys().hasOnly(['schema','hostUid','title','modpackName','minecraftVersion','loader','imageUrl','players','maxPlayers','visibility','joinPolicy','expiresAt'])
        && d.schema == 1 && d.hostUid == request.auth.uid && socialAccount(request.auth.uid)
        && socialText(d.title, 64) && socialText(d.modpackName, 64)
        && socialText(d.minecraftVersion, 24) && socialText(d.loader, 24)
        && socialImage(d.imageUrl) && d.players is int && d.maxPlayers is int
        && d.players >= 0 && d.maxPlayers >= 1 && d.maxPlayers <= 100 && d.players <= d.maxPlayers
        && d.visibility in ['private','friends','public'] && d.joinPolicy in ['open','approval']
        && d.expiresAt is timestamp && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(4, 'h');
    }
    function socialOwnerAfter(uid) { return getAfter(/databases/$(database)/documents/socialOwners/$(uid)).data; }
    function privateSessionRevision(id) {
      return !exists(/databases/$(database)/documents/socialPrivateAudiences/$(id))
        || get(/databases/$(database)/documents/socialPrivateAudiences/$(id)).data.expiresAt <= request.time
        || (exists(/databases/$(database)/documents/socialSessions/$(id)) && request.resource.data == resource.data);
    }
    function socialPrivateActive(id, d, guest) {
      let invitation = get(/databases/$(database)/documents/socialPrivateInvitations/$(id)/guests/$(guest)).data;
      return d.joinPolicy == 'open' && invitation.schema == 1 && invitation.status == 'active'
        && invitation.sessionId == id && invitation.hostUid == d.hostUid && invitation.recipientUid == guest
        && invitation.revision is int && invitation.revision > 0 && invitation.revision <= 4294967295
        && invitation.expiresAt == d.expiresAt && invitation.expiresAt > request.time;
    }
    function socialVisibleSession(id, d) {
      return get(/databases/$(database)/documents/socialOwners/$(d.hostUid)).data.sessionId == id
        && (request.auth.uid == d.hostUid || (d.expiresAt > request.time && !socialBlocked(request.auth.uid, d.hostUid)
          && (d.visibility == 'public' || (d.visibility == 'friends' && socialFriends(request.auth.uid, d.hostUid))
            || (d.visibility == 'private' && socialPrivateActive(id, d, request.auth.uid)))));
    }
    match /socialOwners/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || (resource.data.visibility != 'private' && socialFriends(request.auth.uid, uid)));
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sessionId','visibility'])
        && socialSessionId(request.resource.data.sessionId)
        && (!exists(/databases/$(database)/documents/socialOwners/$(uid)) || resource.data.sessionId == request.resource.data.sessionId
          || (resource.data.visibility == 'private'
            && !existsAfter(/databases/$(database)/documents/socialSessions/$(resource.data.sessionId))
            && !existsAfter(/databases/$(database)/documents/socialCatalog/$(resource.data.sessionId))))
        && getAfter(/databases/$(database)/documents/socialSessions/$(request.resource.data.sessionId)).data.hostUid == uid
        && getAfter(/databases/$(database)/documents/socialSessions/$(request.resource.data.sessionId)).data.visibility == request.resource.data.visibility;
      allow delete: if signedIn() && request.auth.uid == uid
        && !existsAfter(/databases/$(database)/documents/socialSessions/$(resource.data.sessionId))
        && !existsAfter(/databases/$(database)/documents/socialCatalog/$(resource.data.sessionId));
    }
    match /socialSessions/{id} {
      allow list: if false;
      allow get: if signedIn() && socialAccount(request.auth.uid) && socialVisibleSession(id, resource.data);
      allow create, update: if signedIn() && socialSessionId(id) && socialSessionShape(request.resource.data)
        && privateSessionRevision(id)
        && (!exists(/databases/$(database)/documents/socialSessions/$(id)) || resource.data.hostUid == request.auth.uid)
        && socialOwnerAfter(request.auth.uid).sessionId == id
        && socialOwnerAfter(request.auth.uid).visibility == request.resource.data.visibility
        && ((request.resource.data.visibility == 'public' && getAfter(/databases/$(database)/documents/socialCatalog/$(id)).data.expiresAt == request.resource.data.expiresAt)
          || (request.resource.data.visibility != 'public' && !existsAfter(/databases/$(database)/documents/socialCatalog/$(id))));
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/socialCatalog/$(id))
        && (!existsAfter(/databases/$(database)/documents/socialOwners/$(request.auth.uid))
          || (resource.data.visibility == 'private'
            && socialOwnerAfter(request.auth.uid).sessionId != id));
    }
    // The immutable original deadline retains per-recipient tombstones until old grants expire.
    // Reinviting increments the revision; deleting/recreating cannot reset it while it is live.
    function privateAudienceAfter(id) { return getAfter(/databases/$(database)/documents/socialPrivateAudiences/$(id)).data; }
    function privateInvitationAfter(id, guest) {
      return getAfter(/databases/$(database)/documents/socialPrivateInvitations/$(id)/guests/$(guest)).data;
    }
    function privateSessionOwned(id, host, expires) {
      let session = get(/databases/$(database)/documents/socialSessions/$(id)).data;
      return session.hostUid == host && session.visibility == 'private' && session.joinPolicy == 'open'
        && session.expiresAt == expires && expires > request.time
        && get(/databases/$(database)/documents/socialOwners/$(host)).data.sessionId == id;
    }
    function privateInboxMatches(id, host, guest, expires) {
      let pointer = getAfter(/databases/$(database)/documents/socialPrivateInbox/$(guest)/sessions/$(id)).data;
      return pointer.schema == 1 && pointer.sessionId == id && pointer.hostUid == host && pointer.expiresAt == expires;
    }
    function privateInvitationShape(id, guest, d) {
      return d.keys().hasAll(['schema','authorizationId','revision','sessionId','hostUid','recipientUid','status','createdAt','updatedAt','expiresAt'])
        && d.keys().hasOnly(['schema','authorizationId','revision','sessionId','hostUid','recipientUid','status','createdAt','updatedAt','expiresAt'])
        && d.schema == 1 && socialSessionId(id) && socialUid(guest) && socialUid(d.hostUid)
        && d.authorizationId is string && d.authorizationId.matches('^[0-9a-f]{64}$')
        && d.revision is int && d.revision >= 1 && d.revision <= 4294967295
        && d.sessionId == id && d.recipientUid == guest && d.hostUid != guest
        && d.status in ['active','revoked'] && d.createdAt is timestamp && d.updatedAt == request.time
        && d.expiresAt is timestamp;
    }
    function privateActivation(id, guest, d) {
      return request.auth.uid == d.hostUid && d.status == 'active'
        && privateSessionOwned(id, d.hostUid, d.expiresAt) && socialAccount(guest) && !socialBlocked(d.hostUid, guest)
        && guest in privateAudienceAfter(id).recipients && privateAudienceAfter(id).hostUid == d.hostUid
        && privateAudienceAfter(id).expiresAt == d.expiresAt
        && privateInboxMatches(id, d.hostUid, guest, d.expiresAt)
        && getAfter(/databases/$(database)/documents/socialPrivateThrottle/$(d.hostUid)).data.at == request.time;
    }
    match /socialPrivateThrottle/{host} {
      allow get: if signedIn() && request.auth.uid == host;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == host
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && (!exists(/databases/$(database)/documents/socialPrivateThrottle/$(host)) || request.time >= resource.data.at + duration.value(2,'s'));
    }
    match /socialPrivateAudiences/{id} {
      allow list: if signedIn() && resource.data.hostUid == request.auth.uid
        && request.query.limit != null && request.query.limit <= 4;
      allow get: if signedIn() && (resource.data.hostUid == request.auth.uid
        || get(/databases/$(database)/documents/socialSessions/$(id)).data.hostUid == request.auth.uid);
      allow create, update: if signedIn() && socialSessionId(id)
        && request.resource.data.keys().hasAll(['schema','hostUid','sessionId','expiresAt','recipients'])
        && request.resource.data.keys().hasOnly(['schema','hostUid','sessionId','expiresAt','recipients'])
        && request.resource.data.schema == 1 && request.resource.data.hostUid == request.auth.uid && request.resource.data.sessionId == id
        && privateSessionOwned(id, request.auth.uid, request.resource.data.expiresAt)
        && request.resource.data.recipients is list && request.resource.data.recipients.size() >= 1 && request.resource.data.recipients.size() <= 8
        && request.resource.data.recipients.toSet().size() == request.resource.data.recipients.size()
        && ((!exists(/databases/$(database)/documents/socialPrivateAudiences/$(id)) && request.resource.data.recipients.size() == 1)
          || (exists(/databases/$(database)/documents/socialPrivateAudiences/$(id))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipients'])
            && request.resource.data.recipients == resource.data.recipients.concat([request.resource.data.recipients[request.resource.data.recipients.size()-1]])))
        && privateInvitationAfter(id, request.resource.data.recipients[request.resource.data.recipients.size()-1]).status == 'active'
        && privateInvitationAfter(id, request.resource.data.recipients[request.resource.data.recipients.size()-1]).createdAt == request.time;
      allow delete: if signedIn() && request.auth.uid == resource.data.hostUid && resource.data.expiresAt <= request.time;
    }
    match /socialPrivateInvitations/{id}/guests/{guest} {
      allow get: if signedIn() && (request.auth.uid == guest || resource.data.hostUid == request.auth.uid
        || get(/databases/$(database)/documents/socialPrivateAudiences/$(id)).data.hostUid == request.auth.uid
        || get(/databases/$(database)/documents/socialSessions/$(id)).data.hostUid == request.auth.uid);
      allow list: if signedIn() && get(/databases/$(database)/documents/socialPrivateAudiences/$(id)).data.hostUid == request.auth.uid
        && request.query.limit != null && request.query.limit <= 8;
      allow create: if signedIn() && privateInvitationShape(id, guest, request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
        && privateActivation(id, guest, request.resource.data);
      allow update: if signedIn() && privateInvitationShape(id, guest, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedAt'])
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.status != resource.data.status
        && ((resource.data.status == 'revoked' && privateActivation(id, guest, request.resource.data))
          || (request.auth.uid in [guest, resource.data.hostUid] && request.resource.data.status == 'revoked'
            && !existsAfter(/databases/$(database)/documents/socialPrivateInbox/$(guest)/sessions/$(id))));
      allow delete: if signedIn() && request.auth.uid in [guest, resource.data.hostUid]
        && resource.data.expiresAt <= request.time
        && !existsAfter(/databases/$(database)/documents/socialPrivateInbox/$(guest)/sessions/$(id));
    }
    match /socialPrivateInbox/{guest}/sessions/{id} {
      allow get: if signedIn() && (request.auth.uid == guest || resource.data.hostUid == request.auth.uid
        || get(/databases/$(database)/documents/socialPrivateAudiences/$(id)).data.hostUid == request.auth.uid);
      allow list: if signedIn() && request.auth.uid == guest && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if signedIn() && request.resource.data.keys().hasAll(['schema','sessionId','hostUid','expiresAt'])
        && request.resource.data.keys().hasOnly(['schema','sessionId','hostUid','expiresAt'])
        && request.resource.data.schema == 1 && request.resource.data.sessionId == id && request.resource.data.hostUid == request.auth.uid
        && privateInvitationAfter(id, guest).hostUid == request.auth.uid && privateInvitationAfter(id, guest).recipientUid == guest
        && privateInvitationAfter(id, guest).status == 'active' && privateInvitationAfter(id, guest).updatedAt == request.time
        && privateInvitationAfter(id, guest).expiresAt == request.resource.data.expiresAt;
      allow delete: if signedIn() && request.auth.uid in [guest, resource.data.hostUid]
        && (resource.data.expiresAt <= request.time || privateInvitationAfter(id, guest).status == 'revoked');
    }
    // Enumeration contains opaque opt-in ids and expiry only; each projection has its own server authorization.
    match /socialCatalog/{id} {
      allow get: if signedIn() && socialAccount(request.auth.uid);
      allow list: if signedIn() && socialAccount(request.auth.uid) && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if signedIn() && socialSessionId(id)
        && request.resource.data.keys().hasOnly(['schema','expiresAt']) && request.resource.data.schema == 1
        && getAfter(/databases/$(database)/documents/socialSessions/$(id)).data.hostUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/socialSessions/$(id)).data.visibility == 'public'
        && getAfter(/databases/$(database)/documents/socialSessions/$(id)).data.expiresAt == request.resource.data.expiresAt
        && socialOwnerAfter(request.auth.uid).sessionId == id;
      allow delete: if signedIn() && get(/databases/$(database)/documents/socialSessions/$(id)).data.hostUid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/socialSessions/$(id))
          || getAfter(/databases/$(database)/documents/socialSessions/$(id)).data.visibility != 'public');
    }
    function group(id) { return get(/databases/$(database)/documents/socialGroups/$(id)).data; }
    function groupAfter(id) { return getAfter(/databases/$(database)/documents/socialGroups/$(id)).data; }
    function liveGroupInvitation(id, receiver) {
      return socialFriends(id, receiver)
        && get(/databases/$(database)/documents/socialGroupInvites/$(receiver)/hosts/$(id)).data.expiresAt > request.time;
    }
    function groupInviteChange(id, before, after) {
      return after.toSet().difference(before.toSet()).size() == 0
        || (after.size() > 0 && after.toSet().difference(before.toSet()).size() == 1
          && !(after[after.size()-1] in before) && socialFriends(id, after[after.size()-1])
          && getAfter(/databases/$(database)/documents/socialGroupInvites/$(after[after.size()-1])/hosts/$(id)).data.expiresAt > request.time);
    }
    function groupShape(d, id) {
      return d.keys().hasOnly(['ownerUid','name','members','invited','expiresAt','updatedAt'])
        && d.ownerUid == id && socialText(d.name, 48)
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 8 && id in d.members
        && d.members.toSet().size() == d.members.size()
        && d.invited is list && d.invited.size() <= 8 && d.invited.toSet().size() == d.invited.size()
        && !d.members.hasAny(d.invited) && d.expiresAt is timestamp
        && d.expiresAt <= request.time + duration.value(4,'h')
        && d.updatedAt == request.time;
    }
    match /socialGroups/{id} {
      allow list: if false;
      allow get: if signedIn() && (request.auth.uid == id
        || (exists(/databases/$(database)/documents/socialGroups/$(id)) && (request.auth.uid in resource.data.members
          || (request.auth.uid in resource.data.invited && liveGroupInvitation(id, request.auth.uid))))
        || (!exists(/databases/$(database)/documents/socialGroups/$(id))
          && get(/databases/$(database)/documents/socialGroupMembers/$(request.auth.uid)).data.groupId == id));
      allow create: if signedIn() && id == request.auth.uid && socialAccount(id) && groupShape(request.resource.data, id)
        && request.resource.data.members == [id] && request.resource.data.invited == [] && request.resource.data.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/socialGroupMembers/$(id)).data.groupId == id;
      allow update: if signedIn() && groupShape(request.resource.data, id)
        && request.resource.data.name == resource.data.name && request.resource.data.expiresAt == resource.data.expiresAt
        && ((request.auth.uid == id && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
            && groupInviteChange(id, resource.data.invited, request.resource.data.invited))
          || (request.auth.uid != id && request.auth.uid in resource.data.invited && request.resource.data.members == resource.data.members
            && request.resource.data.invited == resource.data.invited.removeAll([request.auth.uid]))
          || (request.auth.uid != id && request.auth.uid in resource.data.members && request.resource.data.invited == resource.data.invited
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && !existsAfter(/databases/$(database)/documents/socialGroupMembers/$(request.auth.uid)))
          || (request.auth.uid in resource.data.invited && socialFriends(request.auth.uid, id)
            && get(/databases/$(database)/documents/socialGroupInvites/$(request.auth.uid)/hosts/$(id)).data.expiresAt > request.time
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && request.resource.data.invited == resource.data.invited.removeAll([request.auth.uid])
            && getAfter(/databases/$(database)/documents/socialGroupMembers/$(request.auth.uid)).data.groupId == id
            && !existsAfter(/databases/$(database)/documents/socialGroupInvites/$(request.auth.uid)/hosts/$(id))));
      allow delete: if signedIn() && id == request.auth.uid;
    }
    match /socialGroupMembers/{uid} {
      allow list: if false;
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['groupId'])
        && socialUid(request.resource.data.groupId) && uid in groupAfter(request.resource.data.groupId).members;
      allow update: if false;
      allow delete: if signedIn() && ((request.auth.uid == uid && (!existsAfter(/databases/$(database)/documents/socialGroups/$(resource.data.groupId))
          || groupAfter(resource.data.groupId).expiresAt <= request.time || !(uid in groupAfter(resource.data.groupId).members)))
        || (request.auth.uid == resource.data.groupId && (!existsAfter(/databases/$(database)/documents/socialGroups/$(resource.data.groupId))
          || !(uid in groupAfter(resource.data.groupId).members))));
    }
    match /socialGroupInvites/{receiver}/hosts/{owner} {
      allow get: if signedIn() && request.auth.uid in [receiver, owner];
      allow list: if signedIn() && request.auth.uid == receiver && request.query.limit != null && request.query.limit <= 8;
      allow create, update: if signedIn() && request.auth.uid == owner && socialFriends(owner, receiver)
        && request.resource.data.keys().hasOnly(['ownerUid','name','expiresAt']) && request.resource.data.ownerUid == owner
        && request.resource.data.name == groupAfter(owner).name && receiver in groupAfter(owner).invited
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(300,'s')
        && request.resource.data.expiresAt <= groupAfter(owner).expiresAt;
      allow delete: if signedIn() && request.auth.uid in [receiver, owner];
    }
    function removedJoinGone(id, old, retained, i) {
      return old.size() <= i || old[i] in retained || !existsAfter(/databases/$(database)/documents/socialJoinRequests/$(id)/guests/$(old[i]));
    }
    function joinRemovalsPaired(id, old, retained) {
      return removedJoinGone(id, old, retained, 0) && removedJoinGone(id, old, retained, 1)
        && removedJoinGone(id, old, retained, 2) && removedJoinGone(id, old, retained, 3)
        && removedJoinGone(id, old, retained, 4) && removedJoinGone(id, old, retained, 5)
        && removedJoinGone(id, old, retained, 6) && removedJoinGone(id, old, retained, 7);
    }
    function ownPendingJoinCancellation(id) {
      let guest = request.auth.uid;
      let pending = get(/databases/$(database)/documents/socialJoinRequests/$(id)/guests/$(guest)).data;
      let old = get(/databases/$(database)/documents/socialJoinQueues/$(id)).data;
      let next = getAfter(/databases/$(database)/documents/socialJoinQueues/$(id)).data;
      return pending.status == 'pending' && pending.guestUid == guest && pending.sessionId == id
        && pending.hostUid != guest && pending.hostUid == old.hostUid
        && pending.expiresAt == old.expiresAt && pending.expiresAt > request.time
        && guest in old.guests && old.guests.size() <= 8
        && next.diff(old).affectedKeys().hasOnly(['guests'])
        && next.guests is list && next.guests.toSet().size() == next.guests.size()
        && next.guests == old.guests.removeAll([guest])
        && !existsAfter(/databases/$(database)/documents/socialJoinRequests/$(id)/guests/$(guest));
    }
    match /socialJoinQueues/{sessionId} {
      allow list: if false;
      allow get: if signedIn() && socialVisibleSession(sessionId, get(/databases/$(database)/documents/socialSessions/$(sessionId)).data);
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['hostUid','guests','expiresAt'])
        && request.resource.data.guests is list && request.resource.data.guests.size() <= 8
        && request.resource.data.guests.toSet().size() == request.resource.data.guests.size()
        && request.resource.data.hostUid == get(/databases/$(database)/documents/socialSessions/$(sessionId)).data.hostUid
        && request.resource.data.expiresAt == get(/databases/$(database)/documents/socialSessions/$(sessionId)).data.expiresAt
        && ((request.auth.uid == request.resource.data.hostUid
            && request.resource.data.guests.toSet().difference(resource.data.guests.toSet()).size() == 0
            && joinRemovalsPaired(sessionId, resource.data.guests, request.resource.data.guests))
          || (exists(/databases/$(database)/documents/socialJoinQueues/$(sessionId))
            && exists(/databases/$(database)/documents/socialJoinRequests/$(sessionId)/guests/$(request.auth.uid))
            && ownPendingJoinCancellation(sessionId))
          || (getAfter(/databases/$(database)/documents/socialJoinRequests/$(sessionId)/guests/$(request.auth.uid)).data.status == 'pending'
        && ((!exists(/databases/$(database)/documents/socialJoinQueues/$(sessionId)) && request.resource.data.guests == [request.auth.uid])
          || (exists(/databases/$(database)/documents/socialJoinQueues/$(sessionId))
            && request.resource.data.guests.toSet() == resource.data.guests.toSet().union([request.auth.uid].toSet())))));
      allow delete: if signedIn() && request.auth.uid == resource.data.hostUid
        && joinRemovalsPaired(sessionId, resource.data.guests, []);
    }
    match /socialJoinRequests/{sessionId}/guests/{guest} {
      allow get: if signedIn() && (request.auth.uid == guest
        || request.auth.uid == get(/databases/$(database)/documents/socialSessions/$(sessionId)).data.hostUid);
      allow list: if signedIn() && request.auth.uid == get(/databases/$(database)/documents/socialSessions/$(sessionId)).data.hostUid
        && request.query.limit != null && request.query.limit <= 8;
      allow create: if signedIn() && request.auth.uid == guest && socialAccount(guest)
        && request.resource.data.keys().hasOnly(['sessionId','hostUid','guestUid','status','expiresAt','updatedAt'])
        && request.resource.data.sessionId == sessionId && request.resource.data.guestUid == guest
        && request.resource.data.hostUid != guest && request.resource.data.status == 'pending' && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt == get(/databases/$(database)/documents/socialSessions/$(sessionId)).data.expiresAt
        && request.resource.data.expiresAt > request.time
        && get(/databases/$(database)/documents/socialSessions/$(sessionId)).data.joinPolicy == 'approval'
        && request.resource.data.hostUid == get(/databases/$(database)/documents/socialSessions/$(sessionId)).data.hostUid
        && socialVisibleSession(sessionId, get(/databases/$(database)/documents/socialSessions/$(sessionId)).data)
        && guest in getAfter(/databases/$(database)/documents/socialJoinQueues/$(sessionId)).data.guests;
      allow update: if signedIn() && request.auth.uid == resource.data.hostUid && request.resource.data.status == 'accepted'
        && request.resource.data.expiresAt > request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && !socialBlocked(resource.data.hostUid, guest);
      allow delete: if signedIn() && (request.auth.uid == resource.data.hostUid
        || (request.auth.uid == guest && ownPendingJoinCancellation(sessionId)));
    }
    match /socialPresence/{uid} {
      allow list: if false;
      allow get: if signedIn() && (request.auth.uid == uid || (resource.data.sharing == 'friends'
        && resource.data.expiresAt > request.time && socialFriends(request.auth.uid, uid)));
      allow create, update: if signedIn() && request.auth.uid == uid
        && socialAccount(uid)
        && request.resource.data.keys().hasAll(['sharing','modpackName','updatedAt','expiresAt'])
        && request.resource.data.keys().hasOnly(['sharing','modpackName','updatedAt','expiresAt'])
        && request.resource.data.sharing in ['hidden','friends']
        && (request.resource.data.modpackName == null || (request.resource.data.modpackName is string && request.resource.data.modpackName.size() <= 64))
        && request.resource.data.updatedAt == request.time && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(120,'s');
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
