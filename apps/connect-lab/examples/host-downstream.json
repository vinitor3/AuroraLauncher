    {
      "serviceId": "aux",
      "protocol": "udp",
      "endpoint": "127.0.0.1:42002",
      "revision": 1,
      "requiredCapability": "datagram",
      "maxDatagramBytes": 1400,
      "udpReturnPolicy": {
        "type": "authorizedDownstream",
