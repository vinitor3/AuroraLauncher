{
  "schemaVersion": 1,
  "id": "aurora_skins",
  "version": "${version}",
  "name": "Aurora Skins",
  "description": "Biblioteca e renderização de skins integradas ao Aurora Core.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.aurora.skins.minecraft.fabric.AuroraSkinsFabricCommon"
    ],
    "client": [
      "com.aurora.skins.minecraft.fabric.AuroraSkinsFabric"
    ]
  },
  "mixins": [
    "aurora_skins.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api-base": "*",
    "fabric-networking-api-v1": "*",
    "fabric-lifecycle-events-v1": "*"
  },
  "suggests": {
    "aurora_core": ">=${coreVersion}"
  },
  "breaks": {
    "aurora_core": "<${coreVersion}"
  }
}
