{
  "schemaVersion": 1,
  "id": "aurora_skins",
  "version": "${version}",
  "name": "Aurora Skins",
  "description": "Biblioteca e renderização de skins integradas ao Aurora Core.",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.aurora.skins.minecraft.fabric.AuroraSkinsFabric"
    ],
    "main": [
      "com.aurora.skins.minecraft.fabric.SkinSyncFabricServer"
    ]
  },
  "mixins": [
    "aurora_skins.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-networking-api-v1": "*",
    "fabric-lifecycle-events-v1": "*"
  },
  "suggests": {
    "aurora_core": ">=1.1.3"
  }
}
