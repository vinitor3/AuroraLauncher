{
  "schemaVersion": 1,
  "id": "aurora_skins",
  "version": "${version}",
  "name": "Aurora Skins",
  "description": "Biblioteca e renderização de skins integradas ao Aurora Core.",
  "environment": "*",
  "entrypoints": {
    "main": ["com.aurora.skins.minecraft.fabric.AuroraSkinsFabricCommon"],
    "client": ["com.aurora.skins.minecraft.fabric.AuroraSkinsFabric"]
  },
  "mixins": ["aurora_skins.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api-base": "*",
    "fabric-networking-api-v1": "*",
    "fabric-lifecycle-events-v1": "*"
  },
  "suggests": { "aurora_core": ">=1.1.3" },
  "breaks": { "aurora_core": "<1.1.3" }
}
