{
  "name": "aurora-smart-launcher-desktop",
  "private": true,
  "version": "0.2.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "social:dev": "vite --mode social-lab --port 1437 --strictPort --host 127.0.0.1",
    "social:build": "tsc -b && vite build --mode social-lab",
    "connect:online:frontend": "tsc -b && vite build --mode connect-online",
    "connect:online:build": "node ../../scripts/build-connect-online.mjs",
    "social:lab:build": "tauri build --debug --no-bundle --features connect-lab --config src-tauri/tauri.social-lab.conf.json -- --offline --locked --jobs 2",
    "connect:lab:dev": "tauri dev --features connect-lab --config src-tauri/tauri.connect-lab.conf.json",
    "connect:lab:build": "tauri build --debug --no-bundle --features connect-lab --config src-tauri/tauri.connect-lab.conf.json -- --offline --locked --jobs 2",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "dompurify": "^3.4.14",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "linkedom": "0.18.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
