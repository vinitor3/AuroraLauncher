{
  "name": "aurora-smart-launcher",
  "private": true,
  "version": "0.2.0-beta.2",
  "scripts": {
    "desktop:dev": "npm --prefix apps/desktop run tauri dev",
    "release:preflight": "powershell -ExecutionPolicy Bypass -File scripts/release-preflight.ps1",
    "release:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-status.ps1",
    "release:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "release:verify-mods": "powershell -ExecutionPolicy Bypass -File scripts/verify-mod-release-matrix.ps1",
    "desktop:build": "npm run release:verify-mods && npm run release:preflight && node scripts/build-desktop-release.mjs",
    "desktop:test": "npm --prefix apps/desktop run build",
    "core:build": "powershell -ExecutionPolicy Bypass -File scripts/build-aurora-core.ps1",
    "skins:build": "powershell -ExecutionPolicy Bypass -File scripts/build-aurora-skins.ps1"
  }
}
