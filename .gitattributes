* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.docx binary
*.exe binary
*.icns binary
*.ico binary
*.jar binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary

# Preserve the exact upstream license texts embedded in the signed JARs.
apps/aurora-core/licenses/*.txt -text whitespace=-blank-at-eof
